<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>ResoniteModLoaderComponentScanner</AssemblyName>
    <RootNamespace>ResoniteModLoaderComponentScanner</RootNamespace>
    <Version>1.11.0</Version>
    <AssemblyVersion>1.11.0.0</AssemblyVersion>
    <FileVersion>1.11.0.0</FileVersion>
    <Deterministic>true</Deterministic>

    <ResonitePath
      Condition="'$(ResonitePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Resonite\</ResonitePath>

    <RepositoryRoot>$(MSBuildThisFileDirectory)..\..\</RepositoryRoot>

    <RmlProjectPath
      Condition="'$(RmlProjectPath)' == '' and Exists('$(RepositoryRoot)ResoniteModLoader\ResoniteModLoader.csproj')">$(RepositoryRoot)ResoniteModLoader\ResoniteModLoader.csproj</RmlProjectPath>

    <RmlProjectPath
      Condition="'$(RmlProjectPath)' == '' and Exists('$(RepositoryRoot)ResoniteModLoader.csproj')">$(RepositoryRoot)ResoniteModLoader.csproj</RmlProjectPath>

    <RmlProjectPath
      Condition="'$(RmlProjectPath)' == ''">$(RepositoryRoot)ResoniteModLoader\ResoniteModLoader.csproj</RmlProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="$(RmlProjectPath)"
      Private="False" />

    <Reference Include="FrooxEngine">
      <HintPath>$(ResonitePath)FrooxEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="Elements.Core">
      <HintPath>$(ResonitePath)Elements.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target
    Name="ValidateRmlProjectPath"
    BeforeTargets="ResolveReferences"
    Condition="!Exists('$(RmlProjectPath)')">

    <Error
      Text="ResoniteModLoader.csproj wurde nicht gefunden: $(RmlProjectPath)" />
  </Target>

  <Target
    Name="CopyEditorTestSuite"
    AfterTargets="Build"
    Condition="'$(CopyToLibraries)' == 'true'">

    <Message
      Text="Copying $(TargetFileName) to $(ResonitePath)rml_mods"
      Importance="high" />

    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(ResonitePath)rml_mods"
      ContinueOnError="true" />
  </Target>
</Project>
